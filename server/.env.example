# Clave de Anthropic. Vive SOLO acá, nunca en el frontend ni en el APK.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo. Por defecto claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# Supabase: se usa la clave PÚBLICA a propósito.
# El servicio consulta con el JWT de cada usuario para que RLS siga aplicando;
# con service_role el asistente podría leer datos de cualquiera.
SUPABASE_URL=https://api.neura.com.py
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=eyJ...

# Orígenes permitidos, separados por coma. Vacío = permitir todos.
# El APK no manda Origin; la autorización real la da el JWT.
ALLOWED_ORIGINS=http://localhost:5173,https://localhost

# Consultas por usuario cada 10 minutos.
RATE_LIMIT=30

PORT=8787
