# ============================================================
#  Reservá.  — Variables de entorno
#  Copiá este archivo como `.env.local` y completá los valores.
#  `.env.local` NO se commitea (está en .gitignore).
# ============================================================

# --- API de Supabase (esto SÍ va dentro del APK) ------------
# Debe ser HTTPS y accesible desde el celular. Nunca uses localhost.
VITE_SUPABASE_URL=https://tu-supabase.ejemplo.com

# Preferido: publishable key (formato sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Compatibilidad: si tu instancia todavía usa la anon key (JWT eyJ...),
# dejá la de arriba vacía y completá ésta.
VITE_SUPABASE_ANON_KEY=

# ============================================================
#  SOLO PARA TU MÁQUINA — nunca llega al frontend ni al APK.
#  La usa `npm run db:push` / `npm run db:seed` para crear el schema.
# ============================================================
DATABASE_URL=postgresql://usuario:clave@host:6432/postgres?sslmode=disable

# NUNCA pongas acá service_role key, secret key ni nada equivalente
# con el prefijo VITE_: Vite embebe TODA variable VITE_* en el bundle.

# --- Asistente (opcional) ---------------------------------
# URL del servicio de server/. Si queda vacía, la burbuja de ayuda no aparece
# y el resto de la app funciona igual.
# La API key de Anthropic vive en ESE servicio, nunca acá.
VITE_ASSISTANT_URL=
