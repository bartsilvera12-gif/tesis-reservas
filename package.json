{
  "name": "tesis-reservas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run build && cap sync android && cap run android",
    "db:push": "node scripts/db-apply.mjs",
    "db:seed": "node scripts/db-apply.mjs --seed",
    "types:gen": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema tesisreserva > src/types/database.types.ts",
    "db:test": "node scripts/test-flows.mjs",
    "db:images": "node scripts/seed-images.mjs",
    "db:reviewers": "node scripts/seed-reviewers.mjs",
    "android:icons": "node scripts/gen-icons.mjs",
    "db:test:owner": "node scripts/test-owner.mjs",
    "auth:probar-correo": "node scripts/probar-correo.mjs",
    "test:recordatorios": "node scripts/test-recordatorios.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.1",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/status-bar": "^7.0.0",
    "@supabase/supabase-js": "^2.48.1",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.1",
    "@types/leaflet": "^1.9.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "shadcn": "^4.18.0",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
